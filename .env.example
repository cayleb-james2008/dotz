# dotz auth — pi resolves provider keys from ~/.pi/agent/auth.json → env vars.
# Set keys for the providers you use (names only here — never commit real values):
#   • Ollama Cloud — PRIMARY: executive model glm-5.2, subagent model minimax-m3
#   • OpenRouter   — free fallback: nex-agi/nex-n2-pro:free
OLLAMA_API_KEY=
OPENROUTER_API_KEY=

# Local server port (default 4317)
DOTZ_PORT=4317

# Optional: extra skill pools (path.delimiter-separated dirs) merged at HIGHEST priority. Each
# dir's SKILL.md descriptions are injected into the agent's system prompt — point only at TRUSTED
# directories. Example (Windows uses ';' as the delimiter):
# DOTZ_SKILLS_PATHS=C:\path\to\skills;C:\another\skill\pool
