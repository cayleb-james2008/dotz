# dotz reads pi's normal auth resolution: ~/.pi/agent/auth.json -> env vars.
# Provide a working provider key for live verification, e.g.:
# ANTHROPIC_API_KEY=sk-ant-...
# Or point pi at a custom Anthropic-compatible route (matches this machine's setup):
# PI_ANTHROPIC_API_KEY=...
# PI_ANTHROPIC_BASE_URL=...

# Local server port (default 4317)
DOTZ_PORT=4317
