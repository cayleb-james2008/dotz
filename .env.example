# dotz provider keys + server config.
#
# dotz resolves provider keys in this order (see docs/provider-setup.md for the full guide):
#   1. Environment variables (listed below) — highest precedence.
#   2. ~/.pi/agent/auth.json — written by the in-UI Connections panel; fallback when env is unset.
# Keys are never logged or sent to telemetry. Only set the providers you use; names only here,
# never commit real values.
#
#   Ollama Cloud  — PRIMARY: executive model glm-5.2, subagent model minimax-m3
#   OpenRouter    — free fallback: nex-agi/nex-n2-pro:free
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=

# Local OpenAI-compatible endpoint (e.g. a local Ollama server). No key needed by default.
# DOTZ_LOCAL_BASE_URL=http://localhost:11434/v1
# DOTZ_LOCAL_API_KEY=

# Local server port (default 4317)
DOTZ_PORT=4317

# Optional: extra skill pools (path.delimiter-separated dirs) merged at HIGHEST priority. Each
# dir's SKILL.md descriptions are injected into the agent's system prompt — point only at TRUSTED
# directories. Example (Windows uses ';' as the delimiter):
# DOTZ_SKILLS_PATHS=C:\path\to\skills;C:\another\skill\pool