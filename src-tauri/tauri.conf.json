{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dotz",
  "version": "0.2.8",
  "identifier": "com.cayleb.dotz",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../web": "web",
      "../.pi": ".pi",
      "../assets": "assets",
      "../node_modules/agent-browser/bin": "agent-browser/bin"
    }
  },
  "plugins": {
